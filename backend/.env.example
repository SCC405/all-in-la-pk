# Puerto del servidor Express
PORT=4000

# Cadena de conexión de MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base-de-datos>
MONGODB_URI=

# Entorno de ejecución: development | production
NODE_ENV=development

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Secreto para la protección CSRF (HU-19)
CSRF_SECRET=

# HTTPS en desarrollo (HU-20). Genera los certificados con: npm run certificados
# En producción se dejan vacíos: el proveedor de despliegue termina TLS.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Activar SOLO en producción detrás de un proxy que termina TLS
TRUST_PROXY=false
FORZAR_HTTPS=false
